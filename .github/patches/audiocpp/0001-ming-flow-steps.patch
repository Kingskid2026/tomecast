+namespace {
+
+// Tomecast patch, not upstream: the number of flow steps and their schedule, read once per
+// process from the environment. Unset or empty, the sampler is exactly upstream's: Euler,
+// 10 steps on the official sway-warped table. An invalid value is reported and ignored.
+//   AUDIOCPP_MING_FLOW_STEPS=N            solver steps, 1 to 10 (default 10)
+//   AUDIOCPP_MING_FLOW_SCHEDULE=default   the official table; with N < 10, its points round(10k/N)
+//                              =uniform   k/N, no warp
+//                              =sway      k/N, then the official warp t' = 1 - cos(pi/2 t)
+int tomecast_flow_steps() {
+    static const int steps = [] {
+        const char * value = std::getenv("AUDIOCPP_MING_FLOW_STEPS");
+        if (value == nullptr || value[0] == '\0') return 10;
+        char * end = nullptr;
+        const long n = std::strtol(value, &end, 10);
+        if (*end != '\0' || n < 1 || n > 10) {
+            std::fprintf(stderr, "Ignoring AUDIOCPP_MING_FLOW_STEPS=%s: it must be a whole number "
+                "from 1 to 10. Using 10.\n", value);
+            return 10;
+        }
+        return static_cast<int>(n);
+    }();
+    return steps;
+}
+
+const std::string & tomecast_flow_schedule_name() {
+    static const std::string schedule = [] {
+        const char * value = std::getenv("AUDIOCPP_MING_FLOW_SCHEDULE");
+        if (value == nullptr || value[0] == '\0') return std::string("default");
+        const std::string name(value);
+        if (name != "default" && name != "uniform" && name != "sway") {
+            std::fprintf(stderr, "Ignoring AUDIOCPP_MING_FLOW_SCHEDULE=%s: it must be default, "
+                "uniform or sway. Using default.\n", value);
+            return std::string("default");
+        }
+        return name;
+    }();
+    return schedule;
+}
+
+// The flow's time points, from 0 to 1, one more than the steps. With the defaults, `official`.
+std::vector<float> tomecast_flow_schedule(const std::vector<float> & official) {
+    const int steps = tomecast_flow_steps();
+    const std::string & schedule = tomecast_flow_schedule_name();
+    std::vector<float> time;
+    if (schedule == "default") {
+        const double last = static_cast<double>(official.size() - 1);
+        for (int k = 0; k <= steps; ++k) time.push_back(official[static_cast<size_t>(std::lround(last * k / steps))]);
+        return time;
+    }
+    for (int k = 0; k <= steps; ++k) time.push_back(static_cast<float>(k) / static_cast<float>(steps));
+    core::round_f32_to_bf16_in_place(time);
+    if (schedule == "sway") {  // the same rounding sequence as the official table's warp
+        auto phase = time;
+        for (auto & t : phase) t *= 1.5707963267948966f;
+        core::round_f32_to_bf16_in_place(phase);
+        for (auto & t : phase) t = std::cos(t);
+        core::round_f32_to_bf16_in_place(phase);
+        for (auto & t : phase) t -= 1.0f;
+        core::round_f32_to_bf16_in_place(phase);
+        for (size_t i = 0; i < time.size(); ++i) phase[i] += time[i];
+        core::round_f32_to_bf16_in_place(phase);
+        for (size_t i = 0; i < time.size(); ++i) time[i] -= phase[i];
+        core::round_f32_to_bf16_in_place(time);
+    }
+    return time;
+}
